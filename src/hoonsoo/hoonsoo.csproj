<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>hoonsoo</AssemblyName>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest><PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WPF owns DPI via manifest; WinForms is used only for tray and monitor enumeration. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Tesseract" Version="5.2.0" /></ItemGroup>
  <ItemGroup><Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" /><Content Include="app.png" CopyToOutputDirectory="PreserveNewest" /><Content Include="tessdata\eng.traineddata" CopyToOutputDirectory="PreserveNewest" /><Content Include="licenses\**" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
